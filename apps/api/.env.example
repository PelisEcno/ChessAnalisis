# Copiar a .env y completar. En docker-compose, DATABASE_URL y REDIS_URL se
# sobreescriben para apuntar a los contenedores (ver docker-compose.yml).
DATABASE_URL=postgres://peonlibre:peonlibre@localhost:5432/peonlibre
REDIS_URL=redis://localhost:6379

# Cualquier string largo y aleatorio; usar `openssl rand -hex 32`.
SESSION_SECRET=

WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000
CONTACT_EMAIL=tu-email@ejemplo.com

# Opcional: sin esto, /auth/google queda deshabilitado (se loguea un aviso).
# Crear credenciales OAuth2 en https://console.cloud.google.com/apis/credentials,
# tipo "Web application", con este Authorized redirect URI:
#   http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
